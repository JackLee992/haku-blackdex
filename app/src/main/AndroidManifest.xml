<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" package="top.niunaijun.blackdex">
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
    <application android:name=".app.App" android:allowBackup="false"
        android:icon="@drawable/haku_chestnut" android:label="@string/app_name"
        android:supportsRtl="true" android:theme="@style/Theme.BlackDex">
        <activity android:name=".view.main.MainActivity" android:exported="true" android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider android:name=".data.ExportProvider" android:authorities="${applicationId}.exports"
            android:exported="false" android:grantUriPermissions="true" />
    </application>
</manifest>
